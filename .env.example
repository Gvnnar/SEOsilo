# Wymagany tylko dla grupowania semantycznego (AI). Bez niego dostępna
# pozostaje metoda leksykalna (offline, bez klucza API).
# Klucz z https://openrouter.ai/keys - grupowanie semantyczne przechodzi
# przez OpenRouter (API kompatybilne z OpenAI), nie bezpośrednio przez Anthropic.
OPENROUTER_API_KEY=

# Opcjonalnie: slug modelu na OpenRouter (np. anthropic/claude-opus-5,
# anthropic/claude-sonnet-5). Domyślnie: anthropic/claude-opus-5.
OPENROUTER_MODEL=
