# Wymagany tylko dla metod embeddingi i semantyczne (AI). Bez niego dostępna
# pozostaje metoda leksykalna (offline, bez klucza API).
# Klucz z https://openrouter.ai/keys - obie metody AI przechodzą przez
# OpenRouter (API kompatybilne z OpenAI), nie bezpośrednio przez Anthropic.
OPENROUTER_API_KEY=

# Opcjonalnie: slug modelu na OpenRouter (np. anthropic/claude-opus-5,
# anthropic/claude-sonnet-5). Domyślnie: anthropic/claude-opus-5.
OPENROUTER_MODEL=

# Opcjonalnie: slug modelu embeddingowego na OpenRouter.
# Domyślnie: openai/text-embedding-3-small.
OPENROUTER_EMBEDDING_MODEL=

# Opcjonalnie: próg podobieństwa kosinusowego (0-1) do łączenia w klaster
# w metodzie embeddingi. Domyślnie: 0.55 - punkt startowy, nieostrojony na
# realnym ruchu.
EMBEDDING_SIMILARITY_THRESHOLD=

# Opcjonalnie: ile podstron pobierać jednocześnie w trybie "Podaj URL strony"
# (1-16, wyżej = szybszy crawl, ale mniej grzeczne wobec crawlowanej strony).
# Domyślnie: 8.
CRAWL_CONCURRENCY=
